  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder -mwl",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "author": "aniruddhaadak80",
  "homepage": "https://github.com/aniruddhaadak80/nightglass",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/nightglass.git"
  },
